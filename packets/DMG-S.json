{
  "description": "DMG-S TwinCAT interface",
  "transmit": {
    "byte_order": ">",
    "fields": [
      {"name": "MotionConsent",               "type": "USINT", "value": "modelConstants['MotionConsent']"},
      {"name": "SimulationRunningHeartbeat",  "type": "USINT", "value": "heartbeat"},
      {"name": "NSimRequest",                 "type": "SINT",  "value": "nSimRequest"},
      {"name": "SteeringTorqueEnableRequest", "type": "USINT", "value": "modelConstants['SteeringTorqueEnableRequest']"},
      {"name": "BResetAvailable",             "type": "USINT", "value": 0},

      {"name": "rWashoutLong",  "type": "REAL", "value": "washoutSettings['rWashoutLong']"},
      {"name": "rWashoutLat",   "type": "REAL", "value": "washoutSettings['rWashoutLat']"},
      {"name": "rWashoutVert",  "type": "REAL", "value": "washoutSettings['rWashoutVert']"},
      {"name": "rWashoutRoll",  "type": "REAL", "value": "washoutSettings['rWashoutRoll']"},
      {"name": "rWashoutPitch", "type": "REAL", "value": "washoutSettings['rWashoutPitch']"},
      {"name": "rWashoutYaw",   "type": "REAL", "value": "washoutSettings['rWashoutYaw']"},

      {"name": "fWashoutLong",  "type": "REAL", "value": "washoutSettings['fWashoutLong']"},
      {"name": "fWashoutLat",   "type": "REAL", "value": "washoutSettings['fWashoutLat']"},
      {"name": "fWashoutVert",  "type": "REAL", "value": "washoutSettings['fWashoutVert']"},
      {"name": "fWashoutRoll",  "type": "REAL", "value": "washoutSettings['fWashoutRoll']"},
      {"name": "fWashoutPitch", "type": "REAL", "value": "washoutSettings['fWashoutPitch']"},
      {"name": "fWashoutYaw",   "type": "REAL", "value": "washoutSettings['fWashoutYaw']"},

      {"name": "zetaWashoutLong",  "type": "REAL", "value": "washoutSettings['zetaWashoutLong']"},
      {"name": "zetaWashoutLat",   "type": "REAL", "value": "washoutSettings['zetaWashoutLat']"},
      {"name": "zetaWashoutVert",  "type": "REAL", "value": "washoutSettings['zetaWashoutVert']"},
      {"name": "zetaWashoutRoll",  "type": "REAL", "value": "washoutSettings['zetaWashoutRoll']"},
      {"name": "zetaWashoutPitch", "type": "REAL", "value": "washoutSettings['zetaWashoutPitch']"},
      {"name": "zetaWashoutYaw",   "type": "REAL", "value": "washoutSettings['zetaWashoutYaw']"},

      {"name": "xLongSpeedPreposMin", "type": "REAL", "value": 0.0},
      {"name": "xLongSpeedPreposMax", "type": "REAL", "value": 0.0},
      {"name": "vCarSpeedPreposMin",  "type": "REAL", "value": 30.0},
      {"name": "vCarSpeedPreposMax",  "type": "REAL", "value": 85.0},

      {"name": "rSideSlipCue",  "type": "REAL", "value": 0.0},
      {"name": "rEngineCue",    "type": "REAL", "value": "physics_data.gas * 0.3 + 0.7"},
      {"name": "rUpshiftCue",   "type": "REAL", "value": 0.0},
      {"name": "rDownshiftCue", "type": "REAL", "value": 0.0, "comment": "This is a vector in GT DiL settings: [2, 2, 2, 1, 1, 1]"},

      {"name": "gLongDemand",   "type": "REAL", "value": "g_long * 9.81"},
      {"name": "gLatDemand",    "type": "REAL", "value": "g_lat * 9.81"},
      {"name": "gVertDemand",   "type": "REAL", "value": "g_vert * 9.81"},
      {"name": "dnRollDemand",  "type": "REAL", "value": "acc_roll"},
      {"name": "dnPitchDemand", "type": "REAL", "value": "acc_pitch"},
      {"name": "dnYawDemand",   "type": "REAL", "value": "acc_yaw"},

      {"name": "vLongExternalCueing", "type": "REAL", "value": 0.0},
      {"name": "vLatExternalCueing",  "type": "REAL", "value": 0.0},
      {"name": "vVertExternalCueing", "type": "REAL", "value": 0.0},
      {"name": "nRollDemand",   "type": "REAL", "value": "physics_data.local_angular_vel[2] * 0"},
      {"name": "nPitchDemand",  "type": "REAL", "value": "physics_data.local_angular_vel[0] * 0"},
      {"name": "nYawDemand",    "type": "REAL", "value": "physics_data.local_angular_vel[1] * 0"},

      {"name": "xLongExternalCueing",  "type": "REAL", "value": 0.0},
      {"name": "xLatExternalCueing",   "type": "REAL", "value": 0.0},
      {"name": "xVertExternalCueing",  "type": "REAL", "value": 0.0},
      {"name": "aRollExternalCueing",  "type": "REAL", "value": "physics_data.roll * -1 * steadyStateGains['aRoll']"},
      {"name": "aPitchExternalCueing", "type": "REAL", "value": "physics_data.pitch * -1 * steadyStateGains['aPitch']"},
      {"name": "aYawExternalCueing",   "type": "REAL", "value": "physics_data.heading * -1 * steadyStateGains['aYaw']"},

      {"name": "vLongCar",  "type": "REAL", "value": "physics_data.speed_kmh / 3.6"},
      {"name": "NMSteer",   "type": "REAL", "value": "int(physics_data.final_ff * modelConstants['TorqueMultiplier'])"},
      {"name": "nEngine",   "type": "REAL", "value": "physics_data.rpms * 0.75 * (2 * 3.142 / 60)"},
      {"name": "NGear",     "type": "REAL", "value": "physics_data.gear - 1"},
      {"name": "aSlipCue",  "type": "REAL", "value": 0.0},
      {"name": "nSlipCar",  "type": "REAL", "value": 0.0},
      {"name": "dnSlipCar", "type": "REAL", "value": 0.0},
      {"name": "timestamp", "type": "REAL", "value": 0.0}
    ]
  },
  "receive": {
    "byte_order": ">",
    "comment": "Platform pose in SI units: metres and radians",
    "fields": [
      {"name": "xLongWorld", "type": "REAL"}, {"name": "xLatWorld", "type": "REAL"}, {"name": "xVertWorld", "type": "REAL"},
      {"name": "aRollWorld", "type": "REAL"}, {"name": "aPitchWorld", "type": "REAL"}, {"name": "aYawWorld", "type": "REAL"}
    ]
  },
  "forward": {
    "byte_order": "<",
    "comment": "OpenTrack 'UDP over network' input: 6 doubles, x/y/z in cm then yaw/pitch/roll in degrees. Invert axes in OpenTrack if needed",
    "fields": [
      {"name": "x",     "type": "LREAL", "value": "xLatWorld * 100"},
      {"name": "y",     "type": "LREAL", "value": "xVertWorld * 100"},
      {"name": "z",     "type": "LREAL", "value": "xLongWorld * 100"},
      {"name": "yaw",   "type": "LREAL", "value": "math.degrees(aYawWorld)"},
      {"name": "pitch", "type": "LREAL", "value": "math.degrees(aPitchWorld)"},
      {"name": "roll",  "type": "LREAL", "value": "math.degrees(aRollWorld)"}
    ]
  }
}
